--mantine-color-anchor:#54a5d4;
--mantine-color-blue-filled:#1e88c7;
--mantine-color-blue-filled-hover:#3494cd;
--mantine-color-blue-light:rgba(30, 136, 199, 0.2);
--mantine-color-blue-light-hover:rgba(30, 136, 199, 0.28);
--mantine-color-blue-light-color:#7dbadf;
--mantine-color-blue-outline:#54a5d4;
--mantine-color-blue-outline-hover:rgba(84, 165, 212, 0.08);
--mantine-color-blue-text:#54a5d4;
--chart-series-1:#54a5d4;
}

html:root[data-mantine-color-scheme="light"]{
--mantine-color-gray-0:#f2f5f8;
--mantine-color-gray-1:#ebeef1;
--mantine-color-gray-2:#e5e7eb;
--mantine-color-gray-3:#dbdee2;
--mantine-color-gray-4:#ced0d6;
--mantine-color-gray-5:#aeafb8;
--mantine-color-gray-6:#888794;
--mantine-color-gray-7:#5a586a;
--mantine-color-gray-8:#434154;
--mantine-color-gray-9:#312e43;
--nebula-card:#f9fcfe;
--nebula-button-ink:#16122a;
--nebula-highlight:#5a8782;
--mantine-color-white:#f9fcfe;
--mantine-color-black:#16122a;
--mantine-color-bright:#16122a;
--mantine-color-body:#e6edf1;
--mantine-color-text:#16122a;
--mantine-color-dimmed:#6c6b7b;
--mantine-color-placeholder:#aeafb8;
--mantine-color-default:#f9fcfe;
--mantine-color-default-hover:#f2f5f8;
--mantine-color-default-color:#16122a;
--mantine-color-default-border:#ced0d6;
--mantine-color-anchor:#1d75ae;
--mantine-color-blue-filled:#1e88c7;
--mantine-color-blue-filled-hover:#1972a7;
--mantine-color-blue-light:rgba(30, 136, 199, 0.1);
--mantine-color-blue-light-hover:rgba(30, 136, 199, 0.14);
--mantine-color-blue-light-color:#1d75ae;
--mantine-color-blue-outline:#1e88c7;
--mantine-color-blue-outline-hover:rgba(30, 136, 199, 0.05);
--mantine-color-blue-text:#1d75ae;
--chart-series-1:#1e88c7;
--chart-tick-color:var(--mantine-color-dimmed);
}

html:root[data-mantine-color-scheme="light"] .xterm .xterm-scrollable-element{
background-color:transparent!important;
}

html:root[data-mantine-color-scheme="light"] .xterm .xterm-rows{
color:var(--mantine-color-text);
}

html:root[data-mantine-color-scheme="light"] :is([class~="text-neutral-400"],[class~="text-neutral-400!"],[class~="light:text-neutral-400!"],[class~="text-gray-400"],[class~="text-gray-400!"],[class~="light:text-gray-400!"],[class~="text-gray-500"],[class~="text-gray-500!"],[class~="light:text-gray-500!"],[class~="text-gray-600"],[class~="text-gray-600!"],[class~="light:text-gray-600!"]){
--color-neutral-400:var(--mantine-color-dimmed);
--color-gray-400:var(--mantine-color-dimmed);
--color-gray-500:var(--mantine-color-dimmed);
--color-gray-600:var(--mantine-color-dimmed);
}

html:root .mantine-Button-root[data-variant="filled"]:not([data-disabled]):not(:disabled){
background-color:color-mix(in srgb,var(--button-bg) 22%,transparent)!important;
border:1px solid color-mix(in srgb,var(--button-bg) 62%,transparent)!important;
color:color-mix(in srgb,var(--button-bg) 55%,var(--nebula-button-ink))!important;
}

html:root .mantine-Button-root[data-variant="filled"]:not([data-disabled]):not(:disabled):hover{
background-color:color-mix(in srgb,var(--button-bg) 34%,transparent)!important;
}

@media (prefers-reduced-motion:no-preference){
html:root [data-nebula-page-enter] > *{
animation:nebula-page-blur 250ms ease-out;
}
}

html:root #sidebar-content a,html:root .nebula-topnav a,html:root .nebula-topnav-menu a{
--nebula-nav-accent:var(--mantine-color-blue-filled);
--nebula-nav-tint:var(--mantine-color-blue-light);
--nebula-nav-ink:var(--mantine-color-blue-light-color);
}

html:root[data-mantine-color-scheme="dark"]{
--nebula-nav-fill:var(--mantine-color-default-hover);
}

html:root[data-mantine-color-scheme="light"]{
--nebula-nav-fill:var(--mantine-color-gray-2);
}

@media (hover:hover){
html:root #sidebar-content a > .mantine-Button-root:not(.active):hover,html:root .nebula-topnav a > .mantine-Button-root:not(.active):hover,html:root .nebula-topnav-menu a > .mantine-Button-root:not(.active):hover{
background-color:color-mix(in srgb,var(--nebula-nav-fill) 60%,transparent);
color:var(--mantine-color-text);
}
}

html:root #sidebar-content a > .mantine-Button-root.active,html:root .nebula-topnav a > .mantine-Button-root.active,html:root .nebula-topnav-menu a > .mantine-Button-root.active{
border-color:transparent;
background-color:var(--nebula-nav-fill);
color:var(--nebula-nav-ink);
}

html:root .nebula-sb-items a:not(.active):hover::before{
background:transparent;
}

`;
