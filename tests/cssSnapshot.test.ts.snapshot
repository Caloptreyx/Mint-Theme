background-color:var(--nebula-nav-fill);
color:var(--mantine-color-text);
}

html:root .nebula-sb-items a:not(.active):hover::before{
background:transparent;
}

html:root #sidebar-content a > .mantine-Button-root,html:root .nebula-topnav a > .mantine-Button-root,html:root .nebula-topnav-menu a > .mantine-Button-root{
