color:var(--nebula-nav-ink);
}

html:root #sidebar-desktop:has(~ :is(#dashboard-root,#server-root,#admin-root)){
max-width:0;
max-height:0;
margin:0;
padding:0;
border:0;
visibility:hidden;
}

html:root .xterm.nebula-terminal .xterm-rows .xterm-cursor.xterm-cursor-bar:not(.xterm-cursor-blink){
box-shadow:2px 0 0 var(--mantine-color-text) inset!important;
}

`;

