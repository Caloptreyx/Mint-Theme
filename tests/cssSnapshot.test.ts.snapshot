}
html:root [data-nebula-page-enter] :is(.mantine-Card-root:not([data-nebula-page-enter] .mantine-Card-root .mantine-Card-root),tbody > tr):nth-child(5){
animation-delay:160ms;
}
html:root [data-nebula-page-enter] :is(.mantine-Card-root:not([data-nebula-page-enter] .mantine-Card-root .mantine-Card-root),tbody > tr):nth-child(6){
animation-delay:200ms;
}
html:root [data-nebula-page-enter] :is(.mantine-Card-root:not([data-nebula-page-enter] .mantine-Card-root .mantine-Card-root),tbody > tr):nth-child(7){
animation-delay:240ms;
}
html:root [data-nebula-page-enter] :is(.mantine-Card-root:not([data-nebula-page-enter] .mantine-Card-root .mantine-Card-root),tbody > tr):nth-child(n+8){
animation-delay:280ms;
}
}

@media (prefers-reduced-motion:no-preference){
html:root :is(.mantine-Modal-content,.mantine-Drawer-content):not([style*="opacity: 0;
"]),html:root :is(.mantine-Popover-dropdown,.mantine-Menu-dropdown,.mantine-Combobox-dropdown):not([style*="opacity: 0;
"]){
transition:none!important;
}
html:root :is(.mantine-Modal-content,.mantine-Drawer-content){
animation:nebula-overlay-slide-up 240ms cubic-bezier(0.2, 0.8, 0.3, 1);
}
html:root :is(.mantine-Popover-dropdown,.mantine-Menu-dropdown,.mantine-Combobox-dropdown){
--nebula-overlay-shift:8px;
transform-origin:top center;
animation:nebula-overlay-slide-up 180ms cubic-bezier(0.2, 0.8, 0.3, 1);
}
html:root :is(.mantine-Popover-dropdown,.mantine-Menu-dropdown,.mantine-Combobox-dropdown)[data-position^="top"]{
transform-origin:bottom center;
}
}

html:root .mantine-Card-root > #title-card-header,html:root .mantine-Card-root > .border-b:first-child:has(> div > h3){
background:transparent;
border-bottom-color:transparent!important;
padding-bottom:0;
}

html:root .mantine-Card-root > #title-card-header > .mantine-Title-root,html:root .mantine-Card-root > .border-b:first-child:has(> div > h3) > div > h3{
padding:4px 12px;
border-radius:999px;
background:var(--mantine-color-blue-light);
color:var(--mantine-color-blue-light-color);
}

html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ * .mantine-Paper-root > div[class~="bg-(--mantine-color-default)"]:has(+ .mantine-Divider-root){
