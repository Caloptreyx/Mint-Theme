flex:0 1 auto!important;
margin-right:auto;
}

html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ div:has(> h2.mantine-Title-root:first-child) > h2,html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ .mantine-Group-root:has(> div:first-child > h2.mantine-Title-root:first-child) > div > h2,html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ form .mantine-Card-root > .mantine-Stack-root > h3.mantine-Title-root:first-child,html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ form .mantine-UnstyledButton-root:first-child:has(+ [aria-hidden="false"]:last-child) > .mantine-Text-root,html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ * .mantine-Paper-root > div[class~="bg-(--mantine-color-default)"]:has(+ .mantine-Divider-root) .mantine-Text-root{
