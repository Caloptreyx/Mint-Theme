}

@media (prefers-reduced-motion:reduce){
html:root #sidebar-content a > .mantine-Button-root .mantine-Button-label > svg,html:root .nebula-topnav a > .mantine-Button-root .mantine-Button-label > svg,html:root .nebula-topnav-menu a > .mantine-Button-root .mantine-Button-label > svg{
transition:none;
}
}

@media (hover:hover){
html:root #sidebar-content a > .mantine-Button-root:not(.active):hover .mantine-Button-label > svg,html:root .nebula-topnav a > .mantine-Button-root:not(.active):hover .mantine-Button-label > svg,html:root .nebula-topnav-menu a > .mantine-Button-root:not(.active):hover .mantine-Button-label > svg{
