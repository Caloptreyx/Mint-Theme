}

html:root .mantine-Tabs-root:has(a[href$="/admin/settings/webauthn"]) ~ * .mantine-Paper-root > div[class~="bg-(--mantine-color-default)"]:has(+ .mantine-Divider-root) + .mantine-Divider-root{
